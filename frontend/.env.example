# Frontend Environment Variables
# Copy this file to .env and update with your actual values

# Battle Royale Socket Server URL (replace with your Render deployment URL)
REACT_APP_BATTLE_ROYALE_SERVER_URL=https://your-render-battle-royale-service.onrender.com

# Other Backend API URL (if using Vercel for other APIs)
REACT_APP_BACKEND_URL=https://your-vercel-app.vercel.app

# Supabase Configuration (if needed for direct frontend access)
REACT_APP_SUPABASE_URL=your_supabase_url
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key
