# Backend Environment Variables Example
# Copy this file to .env and fill in your values

# Environment
NODE_ENV=development

# Server Configuration
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database (Supabase)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key_optional

# Judge0 API Keys (At least one required)
JUDGE0_KEY_1=your_judge0_api_key_1
JUDGE0_KEY_2=your_judge0_api_key_2_optional
JUDGE0_KEY_3=your_judge0_api_key_3_optional

# Security
JWT_SECRET=your_jwt_secret_change_in_production

# Logging
LOG_LEVEL=debug

# Features (optional)
FEATURE_BATTLE_ROYALE=true
FEATURE_CF_DUEL=true
FEATURE_TEAM_DUEL=true

# Game Configuration (optional)
BR_MAX_PLAYERS=8
BR_MIN_PLAYERS=2
BR_START_DELAY=5000
BR_QUESTION_TIMEOUT=300000

# Monitoring (optional)
MONITORING_ENABLED=false
HEALTH_CHECK_PATH=/health
READINESS_PATH=/ready
